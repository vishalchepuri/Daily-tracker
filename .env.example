DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
APP_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="https://dayza.site"
ADMIN_EMAILS="your-email@example.com"
# Comma-separated domains to block during signup/signin, without @.
BLOCKED_EMAIL_DOMAINS="mailinator.com,yopmail.com,tempmail.com"

ABACUSAI_API_KEY="your-ai-api-key"

TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_WEBHOOK_SECRET="replace-with-a-random-telegram-webhook-secret"
TELEGRAM_REMINDER_INTERVAL_MS="60000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Keep false/empty for privacy. If true, Gmail-imported spends store email subject/from.
STORE_GMAIL_METADATA=""

# Upload storage. Use Firebase Storage for the Vercel + Neon production setup.
STORAGE_PROVIDER="firebase"
FIREBASE_STORAGE_BUCKET=""
FIREBASE_STORAGE_PREFIX=""
# Local development can use a path instead of pasting the JSON secret.
FIREBASE_SERVICE_ACCOUNT_PATH=""
# Paste the Firebase service account JSON as one line in Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Firebase Auth web app config. These are public client values from Firebase Console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
